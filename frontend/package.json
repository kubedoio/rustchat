{
  "name": "frontend",
  "private": true,
  "license": "Apache-2.0",
  "version": "0.5.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "check:dependency-policy": "node scripts/check-dependency-policy.mjs",
    "apply:dependency-patches": "node scripts/apply-dependency-patches.mjs",
    "deps:inventory": "npm ls --all --json",
    "test:unit": "vitest run src/",
    "test:e2e": "PLAYWRIGHT_BASE_URL=http://127.0.0.1:4173 PLAYWRIGHT_WEB_SERVER=1 playwright test",
    "test:e2e:settings-parity": "PLAYWRIGHT_BASE_URL=http://127.0.0.1:4173 PLAYWRIGHT_WEB_SERVER=1 playwright test e2e/settings_parity.spec.ts --project=chromium",
    "test:e2e:settings-parity:update": "PLAYWRIGHT_BASE_URL=http://127.0.0.1:4173 PLAYWRIGHT_WEB_SERVER=1 playwright test e2e/settings_parity.spec.ts --project=chromium --update-snapshots",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{js,ts,vue,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{js,ts,vue,css,json}\""
  },
  "dependencies": {
    "@tiptap/extension-placeholder": "^3.28.0",
    "@tiptap/starter-kit": "^3.28.0",
    "@tiptap/vue-3": "^3.28.0",
    "@vueuse/core": "^14.3.0",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.12",
    "highlight.js": "^11.11.1",
    "lucide-vue-next": "^0.577.0",
    "marked": "^12.0.0",
    "match-sorter": "^8.3.0",
    "pinia": "^3.0.4",
    "vue": "^3.5.40",
    "vue-router": "^4.6.4"
  },
  "overrides": {
    "picomatch": "4.0.4",
    "js-yaml": "4.2.0",
    "undici": "7.28.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/dompurify": "^3.2.0",
    "@types/marked": "^5.0.2",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "^10.9.2",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.18",
    "prettier": "^3.9.5",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.7"
  }
}
