# rustchat environment configuration
# Copy this file to .env and adjust values as needed.
#
# Quick start for evaluation:
#   1. cp .env.example .env
#   2. Replace all "replace-me-..." placeholders below
#   3. docker compose up -d --build
#
# For production, see docs/deployment.md

# =============================================================================
# REQUIRED — The backend will fail to start without these
# =============================================================================

# Core server
RUSTCHAT_ENVIRONMENT=production
RUSTCHAT_SERVER_HOST=0.0.0.0
RUSTCHAT_SERVER_PORT=3000

# Site URL — The public-facing URL users access
# ⚠️  PRODUCTION: Must use https:// (required even when behind reverse proxy)
# Behind proxy: Set to the HTTPS URL (e.g., https://chat.example.com)
# The proxy handles TLS, RustChat runs internally on HTTP
RUSTCHAT_SITE_URL=http://localhost:8080

# Cryptographic secrets (generate with: openssl rand -hex 32)
RUSTCHAT_JWT_SECRET=replace-me-with-a-long-random-secret-min-32-chars
RUSTCHAT_JWT_ISSUER=rustchat-local
RUSTCHAT_JWT_AUDIENCE=rustchat-users
RUSTCHAT_JWT_EXPIRY_HOURS=24
RUSTCHAT_ENCRYPTION_KEY=replace-me-with-a-long-random-32-byte-key

# Storage (RustFS/S3)
RUSTCHAT_S3_ENDPOINT=http://localhost:9000
RUSTCHAT_S3_PUBLIC_ENDPOINT=http://localhost:9000
RUSTCHAT_S3_BUCKET=rustchat-uploads
RUSTCHAT_S3_ACCESS_KEY=replace-me-with-random-s3-access-key
RUSTCHAT_S3_SECRET_KEY=replace-me-with-random-s3-secret-key
RUSTCHAT_S3_REGION=us-east-1
# For docker-compose's bundled rustfs service, keep these equal to RUSTCHAT_S3_*.
RUSTFS_ACCESS_KEY=replace-me-with-random-s3-access-key
RUSTFS_SECRET_KEY=replace-me-with-random-s3-secret-key

# Data stores
RUSTCHAT_DATABASE_URL=postgres://rustchat:rustchat@localhost:5432/rustchat
RUSTCHAT_REDIS_URL=redis://localhost:6379

# =============================================================================
# OPTIONAL — Defaults are safe for evaluation; review for production
# =============================================================================

RUSTCHAT_LOG_LEVEL=info

# Retention / Orphan S3 Object Scan
# Periodically scan S3 for objects with no matching files table row and delete them.
# Safe defaults are defined in code; uncomment to override.
# RUSTCHAT_RETENTION_ORPHAN_SCAN_ENABLED=false
# RUSTCHAT_RETENTION_ORPHAN_SCAN_INTERVAL_HOURS=24
# RUSTCHAT_RETENTION_ORPHAN_SCAN_PAGE_SIZE=1000
# RUSTCHAT_RETENTION_ORPHAN_SCAN_PAGE_DELAY_MS=100

# CORS Origins — COMMA-SEPARATED, NO SPACES
# ⚠️  PRODUCTION: Must use https:// only! http:// origins are rejected.
#
# When behind a reverse proxy:
#   - Internal: Proxy → RustChat uses HTTP (e.g., http://rustchat:3000)
#   - External: Browser → Proxy uses HTTPS (e.g., https://chat.example.com)
#   - CORS origins must match what browsers see: https://chat.example.com
#
# Development: http://localhost:8080,http://localhost:5173
# Production:  https://chat.example.com,https://app.example.com
RUSTCHAT_CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173

# DANGER: Enables permissive CORS (Access-Control-Allow-Origin: *) which bypasses
# RUSTCHAT_CORS_ALLOWED_ORIGINS. Only set to `true` for local development.
# Never enable this in production.
RUSTCHAT_ALLOW_DEV_CORS=false

# Database Connection Pool (Production Tuning)
# RUSTCHAT_DB_POOL__MAX_CONNECTIONS=20
# RUSTCHAT_DB_POOL__MIN_CONNECTIONS=5
# RUSTCHAT_DB_POOL__ACQUIRE_TIMEOUT_SECS=3
# RUSTCHAT_DB_POOL__IDLE_TIMEOUT_SECS=600
# RUSTCHAT_DB_POOL__MAX_LIFETIME_SECS=1800

# Admin bootstrap — created automatically on first startup
RUSTCHAT_ADMIN_USER=admin@rustchat.local
RUSTCHAT_ADMIN_PASSWORD=replace-me-with-a-strong-admin-password

# Calls plugin runtime configuration (used by docker-compose backend service)
RUSTCHAT_CALLS_ENABLED=true
RUSTCHAT_CALLS_UDP_PORT=8443
RUSTCHAT_CALLS_TCP_PORT=8443
RUSTCHAT_CALLS_ICE_HOST_OVERRIDE=

# Optional advanced calls defaults (read from backend config)
RUSTCHAT_CALLS_STUN_SERVERS=stun:stun.l.google.com:19302
RUSTCHAT_CALLS_TURN_TTL_MINUTES=1440

# Unread/read parity rollout flags
# Keep these disabled in production until dual-write mismatch SLO is acceptable.
RUSTCHAT_UNREAD_V2_ENABLED=false
RUSTCHAT_POST_UNREAD_WS_ENABLED=true
RUSTCHAT_TEAM_UNREAD_V2_ENABLED=true
RUSTCHAT_COLLAPSED_THREADS_ENABLED=true
RUSTCHAT_POST_PRIORITY_ENABLED=false
RUSTCHAT_THREAD_AUTO_FOLLOW=true

# TURN server compatibility variables (used by docker-compose backend service)
# Set this to your own TURN server if WebRTC relay support is required.
# TURN is disabled by default to avoid routing traffic through third-party infrastructure.
TURN_SERVER_ENABLED=false
TURN_SERVER_URL=
TURN_SERVER_USERNAME=replace-with-turn-username
TURN_SERVER_CREDENTIAL=replace-with-turn-password

# Push Notification Proxy (Sidecar)
# For Android push notifications (FCM)
FIREBASE_PROJECT_ID=replace-with-your-project-id
FIREBASE_KEY_PATH=./secrets/firebase-key.json

# For iOS VoIP push notifications (APNS)
# Uses JWT-based authentication (modern recommended approach)
# 1. Go to Apple Developer Portal → Keys → Add Key
# 2. Enable "Apple Push Notifications service (APNs)"
# 3. Download the .p8 file and note the Key ID
# Host path used for docker volume mount
APNS_KEY_HOST_PATH=./secrets/AuthKey_KEYID.p8
# In-container APNS key path (leave as-is for docker-compose)
# Legacy note: older setups may still use APNS_KEY_PATH as a host path.
APNS_KEY_PATH=/secrets/apns-key.p8
APNS_KEY_ID=replace-with-your-key-id
APNS_TEAM_ID=replace-with-your-team-id
APNS_BUNDLE_ID=io.rustchat.app
APNS_USE_PRODUCTION=false

# Push proxy connection
# For local development without Docker: http://localhost:3001
# For Docker Compose (internal network): http://push-proxy:3000
RUSTCHAT_PUSH_PROXY_URL=http://localhost:3001
# Shared secret for authenticating backend requests to the push proxy
PUSH_PROXY_AUTH_KEY=replace-me-with-a-random-secret

# Meilisearch master key (required when exposing port 7700)
MEILI_MASTER_KEY=replace-me-with-a-random-master-key

# =============================================================================
# AI AGENTS (Phase 1 — Optional)
# =============================================================================
# Required to enable AI agent functionality. If not set, agent runtime is disabled.
# Get your API key from https://platform.openai.com/api-keys
# RUSTCHAT_OPENAI_API_KEY=sk-replace-me-with-your-openai-key
#
# Optional: Override default model and max tokens
# RUSTCHAT_OPENAI_MODEL=gpt-4o-mini
# RUSTCHAT_OPENAI_MAX_TOKENS=2048

# Agent rate limits
# RUSTCHAT_AGENT_MAX_REQUESTS_PER_MINUTE=10
# RUSTCHAT_AGENT_MAX_TOKENS_PER_HOUR=100000

# =============================================================================
# WEB SEARCH TOOL (Phase 3 — Optional)
# =============================================================================
# Optional: Tavily API key for web search tool
# Get your key at https://tavily.com/
# TAVILY_API_KEY=tvly-...

# =============================================================================
# RAG KNOWLEDGE BASE (Phase 2 — Optional)
# =============================================================================
# Requires PostgreSQL with the pgvector extension installed:
#   CREATE EXTENSION IF NOT EXISTS vector;
# Also requires RUSTCHAT_OPENAI_API_KEY (above) for embedding generation.
# Local embedding models are supported as a fallback for air-gapped deployments.
# RUSTCHAT_LOCAL_EMBEDDING_MODEL=/models/bge-small-en-v1.5

# Cloudflare Turnstile (Bot Protection)
# Sign up at https://dash.cloudflare.com/?to=/:account/turnstile
# Create a widget and get your site key and secret key
RUSTCHAT_TURNSTILE_ENABLED=false
RUSTCHAT_TURNSTILE_SITE_KEY=REPLACE_ME_TURNSTILE_SITE_KEY
RUSTCHAT_TURNSTILE_SECRET_KEY=REPLACE_ME_TURNSTILE_SECRET_KEY
# Get keys from https://dash.cloudflare.com/?to=/:account/turnstile
# DO NOT use test keys in production — they always pass verification.

# =============================================================================
# SECURITY HARDENING (Production Recommended)
# =============================================================================

# OAuth Token Delivery Method
# Only "cookie" is supported. Legacy URL/header token delivery is rejected.
RUSTCHAT_SECURITY_OAUTH_TOKEN_DELIVERY=cookie

# Rate Limiting Configuration
# Protects against brute-force attacks on auth endpoints
RUSTCHAT_SECURITY_RATE_LIMIT_ENABLED=true
RUSTCHAT_SECURITY_RATE_LIMIT_AUTH_PER_MINUTE=10
RUSTCHAT_SECURITY_RATE_LIMIT_WS_PER_MINUTE=30

# IMPORTANT: For production, you MUST:
# 1. Use strong secrets (min 32 chars, random, high entropy)
# 2. Set RUSTCHAT_ENVIRONMENT=production (enables strict validation)
# 3. Set unique S3 credentials (do not use shared defaults)
# See docs/security-deployment-guide.md for full details
